#!/usr/bin/env python3
"""Send a notification to the simple-multi-terminal instance that owns this tab.

Reads SMT_SOCKET and SMT_TAB_ID from the environment, both of which the
terminal exports into every tab's shell. Silently does nothing when run
outside the terminal, so it is safe to wire into a shared bashrc or into
Claude Code hooks that may run anywhere.

  smt-notify command-done --exit 1 --seconds 42 --command "npm run build"
  smt-notify claude-waiting "Permission needed for Bash"
  smt-notify claude-done
  smt-notify clear

For the Claude kinds, if no message is given on the command line it will try
to read Claude Code's hook JSON from stdin and pull a message out of it.
"""
import json
import os
import socket
import sys

KINDS = ("command-done", "claude-waiting", "claude-done", "clear")


def stdin_message():
    if sys.stdin is None or sys.stdin.isatty():
        return None
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except (ValueError, OSError):
        return None
    if not isinstance(payload, dict):
        return None
    for key in ("message", "notification", "prompt", "reason"):
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def main(argv):
    if len(argv) < 2 or argv[1] not in KINDS:
        print(f"usage: smt-notify {{{'|'.join(KINDS)}}} [...]", file=sys.stderr)
        return 2

    sock_path = os.environ.get("SMT_SOCKET")
    tab_id = os.environ.get("SMT_TAB_ID")
    if not sock_path or not tab_id:
        return 0  # not running inside simple-multi-terminal

    msg = {"kind": argv[1], "tab_id": tab_id}
    args = argv[2:]
    positional = []
    i = 0
    while i < len(args):
        if args[i] == "--exit" and i + 1 < len(args):
            msg["exit_code"] = int(args[i + 1]); i += 2
        elif args[i] == "--seconds" and i + 1 < len(args):
            msg["seconds"] = float(args[i + 1]); i += 2
        elif args[i] == "--command" and i + 1 < len(args):
            msg["command"] = args[i + 1]; i += 2
        else:
            positional.append(args[i]); i += 1

    if positional:
        msg["message"] = " ".join(positional)
    elif msg["kind"].startswith("claude-"):
        found = stdin_message()
        if found:
            msg["message"] = found

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1.0)
            sock.connect(sock_path)
            sock.sendall((json.dumps(msg) + "\n").encode())
    except OSError:
        return 0  # terminal went away; never fail the caller
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
